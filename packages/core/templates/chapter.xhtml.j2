<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <title>{{ title }}</title>
  <link rel="stylesheet" type="text/css" href="styles.css" />
</head>
<body>
  {% if first_page %}
  <h1>{{ title }}</h1>
  {% if author %}
  <p class="author">{{ author }}</p>
  {% endif %}
  {% endif %}

  {% for block in blocks %}
  {% if block.kind == "gap" %}
  {# nbsp keeps the div from being serialised as <div/>, which some Kindle converters mis-parse #}
  <div class="gap gap-{{ block.gap_lines }}">&#160;</div>
  {% elif block.kind == "chapter" %}
  <h2 class="chapter">
    {{ block.source | nl2br }}
    {% if block.translated %}<span class="dst">{{ block.translated | nl2br }}</span>{% endif %}
  </h2>
  {% elif block.translated %}
  <div class="block">
    <p class="src">{{ block.source | nl2br }}</p>
    <p class="dst">{{ block.translated | nl2br }}</p>
  </div>
  {% else %}
  <p>{{ block.source | nl2br }}</p>
  {% endif %}
  {% endfor %}
</body>
</html>
